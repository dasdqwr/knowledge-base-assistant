# 忽略整个 PyCharm 配置文件夹
.idea/

# 敏感信息
.env

# 大文件 / 本地数据
chroma_db/
data/*
!data/.gitkeep
# 索引清单：机器本地状态，与 chroma_db/ 配套，不该提交
index_manifest.json
index_manifest.json.tmp

# Python 自动生成
__pycache__/
*.pyc
*.pyo

# 缓存（以后可能加）
chunks_cache.pkl
bm25_cache.pkl
.setup_done

# 虚拟环境（你用的是 Conda，但保留无害）
venv/
.venv/

# 构建产物
*.egg-info/
