# ========== LLM API（对话模型，DeepSeek） ==========
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ========== Embedding（向量化） ==========
# 后端二选一：
#   local —— 本地 sentence-transformers，零成本、离线、无限流（首次会下载模型）
#   api   —— 走下面这个 OpenAI 兼容端点，按量计费（余额不足会报 402）
EMBEDDING_BACKEND=local
# 本地嵌入设备：cpu / cuda / mps（仅 EMBEDDING_BACKEND=local 时生效）
LOCAL_EMBEDDING_DEVICE=cpu

# 仅 EMBEDDING_BACKEND=api 时需要填
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ========== PostgreSQL（持久化记忆） ==========
DB_URL=postgresql://your_user:your_password@127.0.0.1:5432/your_db?sslmode=disable

# ========== HuggingFace 缓存与镜像 ==========
# HF_ENDPOINT：中国大陆用户建议开启镜像
HF_ENDPOINT=https://hf-mirror.com
# HF_HUB_DISABLE_XET：关闭 Xet 存储后端。开着时大文件走 cas-server.xethub.hf.co，
# 在镜像/未登录场景下会返回 401 导致下载失败
HF_HUB_DISABLE_XET=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# HF_HOME：模型缓存目录。bge-m3 约 2.2 GB，reranker 约 2.2 GB，
# 建议指向空间充足的盘（不设置则默认 ~/.cache/huggingface）。
# ⚠️ 必须在任何 huggingface/torch 导入之前生效，所以放 .env 由 config 加载；
#    如果自己写脚本，要 `os.environ["HF_HOME"]=...` 写在 import 之前。
# HF_HOME=D:\hf-cache

# ========== Redis（检索缓存） ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password